{
  "name": "suitokensaver",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.mjs",
    "build": "vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "check:live": "node scripts/check-live.mjs",
    "snapshot:collect": "node --env-file-if-exists=.env scripts/collect-snapshot.mjs",
    "snapshot:prices": "node --env-file-if-exists=.env scripts/refresh-snapshot-prices.mjs",
    "cf:build": "wrangler deploy --dry-run --outdir .wrangler/build",
    "cf:dev": "wrangler dev --test-scheduled",
    "test:cloudflare": "npm run cf:build && node --test tests/cloudflare/*.test.mjs"
  },
  "engines": { "node": ">=22" },
  "dependencies": {
    "@mysten/sui": "^2.0.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@vitejs/plugin-react": "^4.7.0",
    "miniflare": "^4.20260426.0",
    "node": "^22.23.4",
    "vite": "^6.4.0",
    "wrangler": "^4.86.0"
  }
}
