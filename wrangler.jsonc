{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "suitokensaver-snapshots",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-05-03",
  "workers_dev": true,
  "vars": {
    "SUI_GRAPHQL_URL": "https://graphql.mainnet.sui.io/graphql"
  },
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SnapshotCoordinator"] },
    { "tag": "v2", "deleted_classes": ["SnapshotCoordinator"] }
  ],
  "d1_databases": [{ "binding": "SNAPSHOTS_DB", "database_name": "suitokensaver-snapshots", "database_id": "d999d99c-b76d-4490-b83a-e4802b44dbe4", "migrations_dir": "cloudflare/migrations" }],
  "observability": { "enabled": true }
}
